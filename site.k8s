apiVersion: apps/v1
kind: Deployment
metadata:
  name: site-demo
spec:
  replicas: 1
  selector:
    matchLabels:
      app: site-demo
  template:
    metadata:
      labels:
        app: site-demo
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      containers:
      - name: site-demo
        image: tet_task:latest
        imagePullPolicy: Never
        securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
        ports:
        - containerPort: 8080
---
apiVersion: v1
kind: Service
metadata:
  name: site-demo
spec:
  type: ClusterIP
  selector:
    app: site-demo
  ports:
  - port: 80
    targetPort: 8080
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: site-demo-ingress
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  ingressClassName: nginx
  rules:
  - host: site.local
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: site-demo
            port:
              number: 80